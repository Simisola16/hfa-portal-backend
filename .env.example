SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
PORT=5000
FRONTEND_ADMIN_URL=http://localhost:5174
FRONTEND_CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175

# ─── Azure / Microsoft Graph API Email Configuration ───────────────────────────
#
# HOW TO SET THIS UP (one-time, takes ~5 minutes in Azure Portal):
#
# 1. Go to https://portal.azure.com → "Azure Active Directory" → "App registrations"
# 2. Click "New registration" → give it a name (e.g. "HFA Portal Mailer") → Register
# 3. Copy the "Application (client) ID"  → paste as AZURE_CLIENT_ID below
# 4. Copy the "Directory (tenant) ID"    → paste as AZURE_TENANT_ID below
# 5. Go to "Certificates & secrets" → "New client secret" → copy the VALUE
#    (NOT the ID!) → paste as AZURE_CLIENT_SECRET below
# 6. Go to "API permissions" → "Add a permission" → "Microsoft Graph"
#    → "Application permissions" → search "Mail.Send" → Add
# 7. Click "Grant admin consent for [your org]" → confirm ✅
# 8. Set AZURE_SENDER_EMAIL to the Microsoft 365 mailbox you want to send FROM
#    (that mailbox must exist in your tenant, e.g. noreply@hfa.org)
#
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-value-here
AZURE_SENDER_EMAIL=noreply@hfa.org

# Display name shown in the email "From" field. If blank, defaults to:
# "Halal Food Authority" <value of AZURE_SENDER_EMAIL>
EMAIL_FROM="Halal Food Authority" <noreply@hfa.org>

# LogSheet signatory email notifications (Phase 8)
# Comma-separated list of ALL HFA internal staff email addresses that should receive
# a signature-request notification whenever a new logsheet is created.
# ALL addresses receive every notification — include backup/delegate staff for each
# role (Mufti, CEO, Manager, Mufti2) so that cover staff are always notified.
# Leave blank to disable email notifications for logsheet creation.
# Example: LOGSHEET_SIGNATORY_EMAILS=mufti@hfa.org,ceo@hfa.org,manager@hfa.org,sharia@hfa.org
LOGSHEET_SIGNATORY_EMAILS=

# Agreement sign-off email notifications (Phase 9)
# Comma-separated list of admin email addresses that should receive
# a notification whenever a client signs a certification agreement.
# Example: AGREEMENT_NOTIFICATION_EMAILS=admin@hfa.org,compliance@hfa.org
AGREEMENT_NOTIFICATION_EMAILS=

# Certificate Permissions/Owner Password (locks generated certificate PDFs against editing)
CERTIFICATE_OWNER_PASSWORD=@Muhayad2000
